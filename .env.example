# ──────────────────────────────────────────
# Web3Auth — Embedded wallet & social login
#   Dashboard: https://dashboard.web3auth.io
#   Docs:      https://web3auth.io/docs
#   Pricing:   https://web3auth.io/pricing (free tier includes mainnet)
# ──────────────────────────────────────────
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=
NEXT_PUBLIC_WEB3AUTH_NETWORK=sapphire_devnet

# ──────────────────────────────────────────
# WalletConnect — External wallet connections (MetaMask, Rainbow, etc.)
#   Dashboard: https://cloud.walletconnect.com
#   Docs:      https://docs.walletconnect.com
#   Pricing:   https://walletconnect.com/pricing (free tier available)
# ──────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ──────────────────────────────────────────
# Chain / Network
#   Chain list:   https://chainlist.org
#   Public RPCs:  https://chainlist.org (click a chain for free RPCs)
#   Alchemy RPCs: https://dashboard.alchemy.com (free tier)
#   Infura RPCs:  https://app.infura.io (free tier)
# ──────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology

# ──────────────────────────────────────────
# Smart Account (ERC-4337) — Bundler & Paymaster
#   Pimlico:   https://dashboard.pimlico.io (free tier available)
#   Docs:      https://docs.pimlico.io
#
# Leave FACTORY_ADDRESS blank to use the canonical pre-deployed
# SimpleAccountFactory for your EntryPoint version (recommended).
# Only set this if you've deployed your own custom factory.
# ──────────────────────────────────────────
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PAYMASTER_URL=

# ──────────────────────────────────────────
# NextAuth — Session management
#   Docs: https://next-auth.js.org
#   Generate a secret: openssl rand -hex 32
# ──────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────
# Admin — set to your wallet address to enable admin routes
# Leave blank to deny all admin access
# ──────────────────────────────────────────
NEXT_PUBLIC_ADMIN_WALLET=

# ──────────────────────────────────────────
# Backend API proxy target (for /api/backend/* rewrite)
# ──────────────────────────────────────────
API_URL=http://127.0.0.1:8080
